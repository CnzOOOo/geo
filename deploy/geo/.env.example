# Copy to .env and replace all values before production use.

# Public backend API base, used by GitHub Pages frontend.
# Example: https://geo-api.example.com/jeecg-boot
GEO_API_URL=https://geo-api.example.com/jeecg-boot
GEO_API_DOMAIN=geo-api.example.com
# Set to true after DNS points to the server; starts Caddy HTTPS.
GEO_ENABLE_PROXY=false

# Caddy HTTPS domain for the backend API.
# Host port exposed to the reverse proxy. Avoid 8080 if another service uses it.
BACKEND_PORT=28080

# Local build image used by deploy-backend.yml / manual server build.
BACKEND_IMAGE=jeecg-geo-backend:local
# Optional if you prefer pulling a prebuilt GHCR image.
# BACKEND_IMAGE=ghcr.io/your-org/jeecg-geo-backend:latest

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=geo
MYSQL_USER=geo
MYSQL_PASSWORD=change-me-db

# Redis
REDIS_PASSWORD=change-me-redis

# Optional AI provider settings.
GEO_AI_APIKEY=
GEO_AI_BASEURL=https://api.deepseek.com
GEO_AI_MODEL=deepseek-chat

# Public merchant website, used by llms.txt / sitemap / JSON-LD.
GEO_SITE_BASEURL=
GEO_SITE_SITENAME=

# Wechatsync is recommended to run on a local publishing workstation.
# Leave empty on the server unless you run a remote browser worker.
WECHATSYNC_TOKEN=
SYNC_WS_PORT=9527
GEO_WECHATSYNC_DEPLOYMENT_MODE=server
